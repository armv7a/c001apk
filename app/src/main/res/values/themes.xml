<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.C001apkCompose" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:colorAccent">#3482FF</item>
        <item name="colorAccent">#3482FF</item>
    </style>
    <style name="Theme.C001apkCompose.Starting" parent="Theme.C001apkCompose">
        <item name="android:windowBackground">@drawable/splash_legacy</item>
    </style>
    <style name="AppThemeTranslucent" parent="Theme.C001apkCompose">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <style name="Theme.C001apkCompose.ImagePreview" parent="AppThemeTranslucent">
        <!-- Mojito animates its own backdrop; a second window dim layer flashes on exit. -->
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
